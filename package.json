{
  "name": "gobilan",
  "private": true,
  "version": "0.1.0",
  "description": "GoBilan (Novadis Digital) \u2014 monorepo PWA, portail partenaires, administration, API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:pwa": "npm run dev -w @gobilan/pwa",
    "dev:partners": "npm run dev -w @gobilan/partners",
    "dev:admin": "npm run dev -w @gobilan/admin",
    "dev:api": "npm run dev -w @gobilan/api",
    "dev:local": "node scripts/dev-local.mjs",
    "preview:local": "node scripts/dev-local.mjs --preview",
    "seed:local": "node --env-file=.env.local --import tsx apps/api/src/local-seed.ts",
    "test:e2e": "node e2e/run-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
