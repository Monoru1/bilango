DATABASE_URL=postgresql://gobilan:change-me@127.0.0.1:55432/gobilan_dev
PIN_PEPPER_HEX=
PAYOUT_KEY_HEX=
FEDAPAY_WEBHOOK_SECRET=
DEV_SEED_ADMIN_EMAIL=admin@novadis.test
DEV_SEED_ADMIN_PASSWORD=
