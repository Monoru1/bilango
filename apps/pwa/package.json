{
  "name": "@gobilan/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GoBilan — PWA des patrons et employés (installation obligatoire). Mode DEMO : données simulées en mémoire.",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gobilan/contracts": "*",
    "@gobilan/domain": "*",
    "@gobilan/ui": "*",
    "jspdf": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "vite": "^7.0.0"
  }
}
