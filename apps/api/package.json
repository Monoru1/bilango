{
  "name": "@gobilan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API GoBilan partag\u00e9e par la PWA, le portail partenaires et l'administration",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "migrate": "node --import tsx src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "test:postgres": "node --input-type=module -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL requis')\" && vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@gobilan/contracts": "*",
    "@gobilan/domain": "*",
    "fastify": "^5.4.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
